# Mr. Pizza Environment Variables
# Copy this to .env.local and fill in your values

# Supabase (get from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Site URL (for metadata, WhatsApp links, etc.)
NEXT_PUBLIC_SITE_URL=https://mrpizza.pk

# WhatsApp Business Number (international format, no + or spaces)
# Example: 15551234567 for US number +1 (555) 123-4567
WHATSAPP_BUSINESS_NUMBER=15551234567
NEXT_PUBLIC_WHATSAPP_NUMBER=15551234567

# Email Service (Resend recommended)
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_EMAIL=info@mrpizza.pk
CONTACT_FROM='Mr. Pizza <onboarding@resend.dev>'

# Optional: Sanity.io for CMS (menu content)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-api-token

# Optional: Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX